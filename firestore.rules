rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPublicFile(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 256
        && data.webViewLink is string && data.webViewLink.size() <= 512;
    }

    // Public Files collection rules
    match /public_files/{fileId} {
      // Anyone can read public files to support guest/public viewing!
      allow read, list: if true;

      // Only registered, signed-in users can upload and write public files
      allow create: if isSignedIn() 
        && isValidId(fileId) 
        && isValidPublicFile(request.resource.data);
        
      // Only signed-in users can delete (in a real app, we might check if they are the owner)
      allow delete: if isSignedIn() && isValidId(fileId);
    }
  }
}
